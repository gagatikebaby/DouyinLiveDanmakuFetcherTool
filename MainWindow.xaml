<Window x:Class="DouyinLiveReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DouyinLiveReceiver.ViewModels"
        xmlns:local="clr-namespace:DouyinLiveReceiver"
        Title="Live消息接收器" 
        Height="700" Width="800"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyMessageCommand}" />
    </Window.InputBindings>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:BooleanToTextConverter x:Key="PauseConverter" FalseText="⏸ 暂停消息更新" TrueText="▶ 恢复消息更新"/>

        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MessageItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📺 Live消息接收器" 
                       FontSize="22" FontWeight="Bold" 
                       Foreground="#333"/>
            <TextBlock Text="{Binding StatusText}" 
                       FontSize="12" Foreground="#666" 
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 输入区域 -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="直播间ID:" 
                           VerticalAlignment="Center"
                           FontSize="14"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="1" 
                         Text="{Binding LiveId, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="2" 
                        Content="▶ 开始监听"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource BtnStyle}"
                        Background="#4CAF50" Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Margin="10,0,0,0"/>

                <Button Grid.Column="3" 
                        Content="⏹ 停止"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource BtnStyle}"
                        Background="#F44336" Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- 主内容区域 - 分为消息列表和日志 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 消息列表 -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Width="700" HorizontalAlignment="Center"
                    Background="White" 
                    CornerRadius="8"
                    BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            CornerRadius="8,8,0,0"
                            Padding="10,8"
                            BorderBrush="#EEE" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：标题和计数 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬 消息列表" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding MessageCount, StringFormat='({0}条)'}"
                                           Margin="10,0,0,0" Foreground="#999" FontSize="12"/>
                            </StackPanel>

                            <!-- 右侧：筛选器和清空按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 类型筛选下拉框 -->
                                <ComboBox ItemsSource="{Binding FilterTypes}"
                                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                          Width="100"
                                          Height="28"
                                          Padding="5,2"
                                          FontSize="12"
                                          BorderBrush="#DDD"
                                          Background="White"
                                          Margin="0,0,15,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Content="{Binding PauseUpdate, Converter={StaticResource PauseConverter}}"
                                        Command="{Binding TogglePauseCommand}"
                                        FontSize="11"
                                        Padding="8,2"
                                        Background="#EEE" Foreground="#666"
                                        Style="{StaticResource BtnStyle}"
                                        Margin="0,0,5,0"/>

                                <Button Content="清空"
                                        Command="{Binding ClearCommand}"
                                        FontSize="11"
                                        Padding="8,2"
                                        Background="#EEE" Foreground="#666"
                                        Style="{StaticResource BtnStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 消息列表 -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Messages}"
                             ItemContainerStyle="{StaticResource MessageItemStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             BorderThickness="0"
                             SelectedItem="{Binding SelectedMessage}"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <!-- 右键菜单 -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制消息" Command="{Binding CopyMessageCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <!-- 双击事件 -->
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding CopyMessageCommand}"/>
                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" 
                                        BorderBrush="#F0F0F0" 
                                        BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Icon}" 
                                                   FontSize="14" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{Binding Color}"/>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Time}"
                                                   FontSize="10"
                                                   Foreground="#BBB"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Python日志 -->
            <Border Grid.Column="2"  Visibility="Collapsed"
                    Background="White" 
                    CornerRadius="8"
                    BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0" 
                            Background="#FAFAFA" 
                            CornerRadius="8,8,0,0"
                            Padding="10,8"
                            BorderBrush="#EEE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🐍 Python日志" FontWeight="Bold" FontSize="13"/>
                            <Button Content="清空" 
                                    Command="{Binding ClearLogsCommand}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="20,0,0,0"
                                    Background="#EEE" Foreground="#666"
                                    Style="{StaticResource BtnStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 日志列表 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding RunnerLogs}"
                             BorderThickness="0"
                             Background="#1E1E1E"
                             FontFamily="Consolas"
                             FontSize="11">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Foreground="#DCDCDC"
                                           TextWrapping="Wrap"
                                           Margin="5,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" 
                   Text="提示: 输入直播间ID后点击「开始监听]"
                   Foreground="#999" 
                   FontSize="11"
                   Margin="0,10,0,0"
                   TextAlignment="Center"/>
    </Grid>
</Window>
